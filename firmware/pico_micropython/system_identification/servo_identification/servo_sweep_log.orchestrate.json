{
  "orchestration_version": 1,
  "description": "Static servo sweep that discovers the responsive range: walks outward from center in both directions and stops at encoder-flatline (true saturation). Probes past the standard hobby range to locate where control effectively stops.",
  "remote_config_path": "run_config.json",
  "write_manifest": false,

  "repeat_sequence": {
    "count": 2
  },

  "sequence": [
    {
      "name": "servo_static_pwm_to_angle_sweep",
      "script": "servo_sweep_log.py",
      "config": {
        "FILENAME": "servo_static_pwm_to_angle_sweep",
        "SERVO_CENTER_US": 1431,
        "SERVO_ABS_MIN_US": 100,
        "SERVO_ABS_MAX_US": 3000,
        "SERVO_FREQ_HZ": 330,

        "STEP_US": 25,
        "HOLD_MS": 250,
        "N_SWEEPS": 2,

        "STALL_DELTA_COUNTS": 4,
        "STALL_STEPS_LIMIT": 3,
        "STALL_HOLD_MS": 120
      }
    }
  ]
}
