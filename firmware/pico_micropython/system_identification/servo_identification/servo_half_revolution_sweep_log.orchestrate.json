{
  "orchestration_version": 1,
  "description": "Repeated servo half-revolution sweep for encoder count-to-angle calibration.",
  "remote_config_path": "run_config.json",
  "write_manifest": false,

  "repeat_sequence": {
    "count": 2
  },

  "sequence": [
    {
      "name": "servo_half_revolution_sweep_calibration",
      "script": "servo_half_revolution_sweep_log.py",
      "config": {
        "FILENAME": "servo_half_revolution_sweep_calibration.csv",
        "SERVO_0_DEG_US": 450,
        "SERVO_180_DEG_US": 2450,
        "SERVO_CENTER_US": 1450,

        "STEP_US": 25,
        "HOLD_MS": 300,
        "N_SWEEPS": 2,
        "ENDPOINT_SETTLE_MS": 1000,

        "EXPECTED_COUNTS_PER_REV": 2400,
        "EXPECTED_COUNTS_HALF_REV": 1200,
        "EXPECTED_DEG_RANGE": 180.0
      }
    }
  ]
}