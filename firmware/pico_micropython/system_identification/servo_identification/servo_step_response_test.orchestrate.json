{
  "orchestration_version": 1,
  "description": "Repeated servo step-response test for command-to-angle dynamic identification. Center and static gain come from lib/servo_static_map.py (uploaded below); the step transient is captured at 1 kHz (RAM-buffered, microsecond-timestamped) so peak slew rate, delay, and the rate-limit plateau are well resolved. PWM stays at 200 Hz to match the PRPS-identified actuation regime.",
  "remote_config_path": "run_config.json",
  "write_manifest": false,

  "uploads": [
    {
      "local": "firmware/pico_micropython/lib/servo_static_map.py",
      "remote": "lib/servo_static_map.py"
    }
  ],

  "repeat_sequence": {
    "count": 2
  },

  "sequence": [
    {
      "name": "servo_step_response_test",
      "script": "servo_step_response_test.py",
      "config": {
        "FILENAME": "servo_step_response_test",
        "SERVO_MIN_US": 450,
        "SERVO_MAX_US": 2450,
        "SERVO_FREQ_HZ": 200,

        "SAMPLE_PERIOD_MS": 20,
        "STEP_SAMPLE_PERIOD_MS": 1,
        "STEP_FAST_WINDOW_MS": 350,
        "FLUSH_EVERY_N_ROWS": 50,
        "PRE_STEP_HOLD_MS": 800,
        "POST_STEP_HOLD_MS": 1500,
        "BETWEEN_STEP_CENTER_HOLD_MS": 800,

        "STEP_CASES": [
          {
            "label": "center_to_pos_10deg",
            "start_us": 1431,
            "end_us": 1321,
            "reps": 3
          },
          {
            "label": "center_to_neg_10deg",
            "start_us": 1431,
            "end_us": 1541,
            "reps": 3
          },
          {
            "label": "center_to_pos_20deg",
            "start_us": 1431,
            "end_us": 1211,
            "reps": 3
          },
          {
            "label": "center_to_neg_20deg",
            "start_us": 1431,
            "end_us": 1651,
            "reps": 3
          },
          {
            "label": "pos_20deg_to_neg_20deg",
            "start_us": 1211,
            "end_us": 1651,
            "reps": 3
          },
          {
            "label": "neg_20deg_to_pos_20deg",
            "start_us": 1651,
            "end_us": 1211,
            "reps": 3
          }
        ]
      }
    }
  ]
}