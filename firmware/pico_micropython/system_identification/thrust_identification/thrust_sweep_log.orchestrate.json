{
  "orchestration_version": 1,
  "description": "One GP14 static thrust sweep using the throttle range defined in thrust_sweep_log.py, with MAVLink battery telemetry.",
  "remote_config_path": "run_config.json",
  "write_manifest": false,

  "segments": [
    {
      "name": "gp14_thrust_sweep",
      "config": {
        "NUM_SWEEPS": 1,
        "ESC_PINS": [14],
        "USE_THROTTLE_PERCENT_SWEEP": true,
        "MIN_THROTTLE_PCT": 0,
        "THROTTLE_STEP_PCT": 5,
        "BATTERY_CONNECT_WAIT_MS": 12000,
        "CALIBRATE_LOAD_CELL_WITH_WEIGHTS": true,
        "CALIBRATION_MASSES_G": [50, 200]
      }
    }
  ]
}
